% --- Identification -------------------------------------------------------
\ProvidesExplPackage{vitaethemeclassic}{2026-11-24}{0.6.0}{vitae classic theme}

% --- Fonts ----------------------------------------------------------------
% TeX Gyre Pagella: Type 1 on pdfTeX, OpenType (by file name) elsewhere.
\sys_if_engine_pdftex:TF
  { \RequirePackage { tgpagella } }
  {
    \RequirePackage { fontspec }
    \setmainfont { texgyrepagella }
      [
        Extension      = .otf ,
        UprightFont    = *-regular ,
        BoldFont       = *-bold ,
        ItalicFont     = *-italic ,
        BoldItalicFont = *-bolditalic ,
      ]
  }

% --- Page and lists -------------------------------------------------------
\RequirePackage { enumitem }
\setlist { nosep , leftmargin = 1em , topsep = 2pt }
% Defaults via \keys_set:nn, not \vitaesetup, so user settings still win.
\keys_set:nn { vitae / setup } { accent = black }

% --- Templates ------------------------------------------------------------
% Masthead: centred small-caps name, job title, contacts on one wrapped line;
% then the masthead body, if any, as a justified block.
\settemplate { masthead }
  {
    { \centering
      \taggedheading { 1 }
        { { \LARGE \scshape \color { vitaeaccent } \thefirstname \c_space_tl \thelastname \par } }
      \ifvitaeset { jobtitle } { \smallskip { \large \itshape \thejobtitle \par } } { }
      \medskip \small \printcontacts \par }
    \iffield { body } { \medskip \field { body } \par } { }
    \bigskip
  }
\settemplate { contact } { \mbox { \field { icon } ~ \field { text } } }
% Separator vanishes at a line break, so no line starts or ends with a bullet.
\settemplate { contactsep }
  { \discretionary { } { } { \kern .6em \textbullet \kern .6em } }

% Section: small-caps title over a full-width rule, kept with what follows.
\settemplate { section }
  {
    \par \addvspace { \bigskipamount }
    \taggedheading { 2 } { { \large \scshape \color { vitaeaccent } \field { title } \par } }
    \nopagebreak \vspace { 1pt } \decorative { \hrule } \nopagebreak \medskip
  }

% Entry: bold title and dates on one line, italic org and location below.
% Each line is emitted only if one of its fields is set (no blank lines).
% Dates, then " · <duration>" when durations are on.
\cs_new_protected:Npn \__vitae_classic_dates:
  {
    \field { dates }
    \iffield { duration } { ~ \textperiodcentered \c_space_tl \field { duration } } { }
  }
\cs_new_protected:Npn \__vitae_classic_first_line:
  { \textbf { \field { title } } \hfill \__vitae_classic_dates: \par \nopagebreak }
\settemplate { entry }
  {
    \par
    \iffield { title } { \__vitae_classic_first_line: }
      { \iffield { dates } { \__vitae_classic_first_line: } { } }
    \iffield { org }
      { \textit { \field { org } } \iffield { location } { \hfill \field { location } } { } \par }
      { \iffield { location } { \hfill \field { location } \par } { } }
    \iffield { body } { \smallskip \field { body } \par } { }
    \medskip
  }

% Compact entry: one line, bold title then organisation and location,
% dates on the right; any body follows below.
\settemplate { entry/compact }
  {
    \par
    \joinfields { , ~ } { title = \textbf , org = \textit , location }
    \hfill \__vitae_classic_dates: \par
    \iffield { body } { \field { body } \par } { }
    \smallskip
  }

% Inline entry: a run-in paragraph, "Title, Org, Location (dates). Body"
% (only dates: "dates. Body"); no doubled or stray punctuation.
\settemplate { entry/inline }
  {
    \par
    \ifanyfield { title , org , location }
      {
        \joinfields { , ~ } { title = \textbf , org = \textit , location }
        \iffield { dates }
          { ~ ( \field { dates } \iffield { duration } { , ~ \field { duration } } { } ) } { }
      }
      { \field { dates } }
    \addpunct { . } \iffield { body } { \ifanyfield { title , org , location , dates } { ~ } { } } { }
    \field { body } \par
    \smallskip
  }

% Item: bold label in a fixed left column, wrapped text on the right.
\settemplate { item }
  {
    \par
    \parbox [ t ] { 3cm } { \raggedright \textbf { \field { label } } }
    \parbox [ t ] { \dim_eval:n { \linewidth - 3cm } } { \field { body } }
    \par \smallskip
  }

% Letter opening: recipient on the left, date on the right, salutation.
\settemplate { opening }
  {
    \par
    \iffield { name } { \field { name } \par } { }
    \iffield { address } { \field { address } \par } { }
    \iffield { date } { \bigskip { \raggedleft \field { date } \par } } { }
    \bigskip
    \iffield { text } { \field { text } \par \medskip } { }
  }
% Letter closing: closing words, space to sign, the name in small capitals.
\settemplate { closing }
  {
    \par \medskip \nopagebreak
    \iffield { text } { \field { text } \par \nopagebreak } { }
    \vspace { 2 \baselineskip } \nopagebreak
    { \scshape \color { vitaeaccent } \thefirstname \c_space_tl \thelastname \par }
  }

% Footer: centred, small italic parts separated by bullets.
\settemplate { footer }
  {
    \hfil \footnotesize \itshape
    \joinfields { \kern .6em \textbullet \kern .6em } { name , pages , updated }
    \hfil
  }
