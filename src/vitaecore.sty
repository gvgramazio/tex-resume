      \keys_set:nn { vitae / locale } {#2}
      \__vitae_date_save:n {#1}
      \clist_map_inline:Nn \l__vitae_dl_aliases_clist
        { \tl_gset:cn { g__vitae_locale_alias_##1_tl } {#1} }
      \tl_gset:cn { g__vitae_locale_alias_#1_tl } {#1}
