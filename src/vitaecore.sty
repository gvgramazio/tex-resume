% --- Footer ---------------------------------------------------------------
% The page style "vitae" (the default) runs the footer template on every
% page, with the parts listed in the footer setting: name, pages ("Page 2
% of 3") and updated ("Last updated <date>", from \lastupdated), in the
% words of the locale. Without parts it prints nothing, like "empty".
\clist_new:N \l__vitae_footer_clist
\bool_new:N \l__vitae_footer_single_bool
\msg_new:nnn { vitae } { unknown-footer-part }
  { Unknown~footer~part~'#1';~use~name,~pages~or~updated. }
\keys_define:nn { vitae / setup }
  {
    footer           .code:n =
      {
        \clist_set:Nn \l__vitae_footer_clist {#1}
        \clist_map_inline:Nn \l__vitae_footer_clist
          {
            \clist_if_in:nnF { name , pages , updated } {##1}
              { \msg_error:nnn { vitae } { unknown-footer-part } {##1} }
          }
      } ,
    % False: no footer on a document of one page (as counted last run).
    singlepagefooter .bool_set:N = \l__vitae_footer_single_bool ,
    singlepagefooter .initial:n  = true ,
    singlepagefooter .default:n  = true ,
  }
% Total pages from the previous run (the kernel's count); ?? on the first.
\cs_new:Npn \__vitae_total_pages:
  { \int_compare:nNnTF { \PreviousTotalPages } > { 0 } { \PreviousTotalPages } { ?? } }
\cs_new_protected:Npn \__vitae_footer:
  {
    \bool_lazy_and:nnT
      { ! \clist_if_empty_p:N \l__vitae_footer_clist }
      {
        \bool_lazy_or_p:nn { \l__vitae_footer_single_bool }
          { ! \int_compare_p:nNn { \PreviousTotalPages } = { 1 } }
      }
      {
        \group_begin:
          \clist_if_in:NnT \l__vitae_footer_clist { name }
            {
              \bool_lazy_and:nnF
                { \tl_if_blank_p:V \g__vitae_field_firstname_tl }
                { \tl_if_blank_p:V \g__vitae_field_lastname_tl }
                { \tl_set:Nn \l__vitae_f_name_tl { \thefirstname \c_space_tl \thelastname } }
            }
          \clist_if_in:NnT \l__vitae_footer_clist { pages }
            {
              \tl_set:Nn \l__vitae_f_pages_tl
                { \__vitae_date_pattern:nnnn { pages } { \thepage } { \__vitae_total_pages: } { } }
            }
          \clist_if_in:NnT \l__vitae_footer_clist { updated }
            {
              \tl_if_blank:VF \g__vitae_field_lastupdated_tl
                {
                  % \formatdate parses its argument as typed: pass the value.
                  \tl_set:Ne \l__vitae_f_updated_tl
                    {
                      \exp_not:N \__vitae_date_pattern:nnnn { updated }
                        { \exp_not:N \formatdate { \exp_not:V \g__vitae_field_lastupdated_tl } }
                        { } { }
                    }
                }
            }
          \__vitae_template_use:n { footer }
        \group_end:
      }
  }
\cs_new_protected:Npn \ps@vitae
  {
    \ps@empty
    \cs_set_eq:NN \@oddfoot \__vitae_footer:
    \cs_set_eq:NN \@evenfoot \__vitae_footer:
  }
\pagestyle { vitae }

% --- Lists ----------------------------------------------------------------
% Named lists store unexpanded \cventry/\cvitem calls, which vitae prints in
% order. vitaeletter stores them too, so one data file serves both classes.
\cs_new_protected:Npn \__vitae_list_put:nn #1#2
  {
    \seq_if_exist:cF { g__vitae_list_#1_seq } { \seq_new:c { g__vitae_list_#1_seq } }
    \seq_gput_right:cn { g__vitae_list_#1_seq } {#2}
  }
\NewDocumentCommand \addentry { m m +m } { \__vitae_list_put:nn {#1} { \cventry {#2} {#3} } }
\NewDocumentCommand \additem { m m +m } { \__vitae_list_put:nn {#1} { \cvitem {#2} {#3} } }

% --- Regions --------------------------------------------------------------
% A region is a part of the page that a theme lays out: "main" is the normal
% flow, "aside" complementary content; themes may place other regions. The
% document routes content to a region (\printentries[region=...], the region
% environment) in reading order; the theme declares the regions it places
% (\vitaeplaceregions) and prints each where its layout wants it
% (\useregion). Content for main, or for a region the theme does not place,
% is printed in place.
\msg_new:nnn { vitae } { region-in-place }
  {
    Theme~'#2'~does~not~place~region~'#1':~its~content~is~printed~in~
    place,~which~may~not~look~as~intended.
  }
\msg_new:nnn { vitae } { region-unused }
  { Theme~'#2'~places~region~'#1'~but~never~prints~its~content. }
\msg_new:nnn { vitae } { region-changed }
  { Region~'#1'~has~changed.~Rerun~to~get~it~right. }
\seq_new:N \g__vitae_regions_seq
\seq_new:N \g__vitae_regions_warned_seq
\tl_new:N \l__vitae_region_tl
% \vitaeplaceregions{<regions>}: in a theme, the regions it prints.
\NewDocumentCommand \vitaeplaceregions { m }
  {
    \clist_map_inline:nn {#1}
      {
        \str_if_eq:nnF {##1} { main }
          {
            \seq_if_in:NnF \g__vitae_regions_seq {##1}
              {
                \seq_gput_right:Nn \g__vitae_regions_seq {##1}
                \tl_new:c { g__vitae_region_##1_tl }
              }
          }
      }
  }
\@onlypreamble \vitaeplaceregions
% Route: store <content> in a placed region, else run <in place> (with one
% warning per region, unless it is main).
\cs_new_protected:Npn \__vitae_region:nnn #1#2#3
  {
    \seq_if_in:NnTF \g__vitae_regions_seq {#1}
      { \tl_gput_right:cn { g__vitae_region_#1_tl } {#2} }
      {
        \str_if_eq:nnF {#1} { main }
          {
            \seq_if_in:NnF \g__vitae_regions_warned_seq {#1}
              {
                \seq_gput_right:Nn \g__vitae_regions_warned_seq {#1}
                \msg_warning:nnnV { vitae } { region-in-place } {#1} \g__vitae_theme_tl
              }
          }
        #3
      }
  }
\cs_generate_variant:Nn \__vitae_region:nnn { V }
% \begin{region}{<region>} ... \end{region}: route free text.
\NewDocumentEnvironment { region } { m +b } { \__vitae_region:nnn {#1} {#2} {#2} } { }
% Two passes, like a table of contents: region content is written to the
% .aux file and printed from there on the next run, so a theme can print it
% before the point where the document routes it (an aside at the top of
% page 1). Without an .aux entry, what was routed so far is printed; if that
% differs from the final content, a rerun is requested.
\cs_new_protected:Npn \__vitae_region_get:nN #1#2
  {
    \tl_if_exist:cTF { g__vitae_region_#1_aux_tl }
      { \tl_set_eq:Nc #2 { g__vitae_region_#1_aux_tl } }
      {
        \tl_if_exist:cTF { g__vitae_region_#1_tl }
          { \tl_set_eq:Nc #2 { g__vitae_region_#1_tl } }
          { \tl_clear:N #2 }
      }
  }
% \useregion{<region>}: print it (in a theme); what is printed is kept for
% the comparison at the end of the document.
\NewDocumentCommand \useregion { m }
  {
    \__vitae_region_get:nN {#1} \l__vitae_region_tl
    \tl_gset_eq:cN { g__vitae_region_#1_used_tl } \l__vitae_region_tl
    \tl_use:N \l__vitae_region_tl
  }
\NewDocumentCommand \ifregionempty { m +m +m }
  {
    \__vitae_region_get:nN {#1} \l__vitae_region_tl
    \tl_if_empty:NTF \l__vitae_region_tl {#2} {#3}
  }
% .aux entries: \vitae@region{<region>}{<content>}. The content is read as
% the body of a definition, so the # that writing doubled come back single.
% Only the read at \begin{document} counts (LaTeX reads the file again at
% the end).
\tl_new:N \g__vitae_region_name_tl
\tl_new:N \g__vitae_region_read_tl
\cs_new_protected:Npn \vitae@region #1
  {
    \tl_gset:Nn \g__vitae_region_name_tl {#1}
    \tex_afterassignment:D \__vitae_region_read:
    \tex_long:D \tex_gdef:D \g__vitae_region_read_tl
  }
\cs_new_protected:Npn \__vitae_region_read:
  {
    \tl_gset_eq:cN { g__vitae_region_ \g__vitae_region_name_tl _aux_tl }
      \g__vitae_region_read_tl
  }
\hook_gput_code:nnn { begindocument } { vitae }
  {
    \cs_gset_protected:Npn \vitae@region #1#2 { }
    % The .aux stays readable if vitae is no longer used.
    \bool_lazy_and:nnT
      { \legacy_if_p:n { @filesw } }
      { ! \seq_if_empty_p:N \g__vitae_regions_seq }
      { \iow_now:Nn \@auxout { \providecommand \vitae@region [2] { } } }
  }
% At the end: write each region's content, warn about content the theme
% never printed and about printed content that has changed since.
\cs_new_protected:Npn \__vitae_region_finish:
  {
    \seq_map_inline:Nn \g__vitae_regions_seq
      {
        \tl_if_empty:cF { g__vitae_region_##1_tl }
          {
            \legacy_if:nT { @filesw }
              {
                \iow_now:Ne \@auxout
                  {
                    \token_to_str:N \vitae@region {##1}
                      { \exp_not:v { g__vitae_region_##1_tl } }
                  }
              }
            \tl_if_exist:cF { g__vitae_region_##1_used_tl }
              { \msg_warning:nnnV { vitae } { region-unused } {##1} \g__vitae_theme_tl }
          }
        \tl_if_exist:cT { g__vitae_region_##1_used_tl }
          {
            \str_if_eq:eeF
              { \tl_to_str:c { g__vitae_region_##1_used_tl } }
              { \tl_to_str:c { g__vitae_region_##1_tl } }
              { \msg_warning:nnn { vitae } { region-changed } {##1} }
          }
      }
  }
\hook_gput_code:nnn { enddocument / afterlastpage } { vitae } { \__vitae_region_finish: }

% --- Aside column ---------------------------------------------------------
% A layout helper that themes may call: the "aside" template (by default
% the aside region) in a column beside main. At \begin{document} the text
% block is split: the column takes <width> plus <sep> on its <side>, and
% main keeps the rest, on every page. \placeaside typesets the column into
% a box, in source order, and hangs the part that fits beside main at the
% current point; each later page gets the next part at its top, from the
% output routine (build/page/before), until the column is used up, adding
% pages if it outlasts main. Content stays in the page body: column layouts
% that move typeset material (paracol) or add it from shipout hooks lose
% the structure of tagged PDF. Under tagging the column is an Aside element,
% moved after main in the structure tree (order=after) or left where
% \placeaside is (order=before).
\msg_new:nnn { vitae } { no-aside-column }
  { \iow_char:N \\placeaside~needs~\iow_char:N \\vitaeasidecolumn~in~the~preamble. }
\msg_new:nnn { vitae } { aside-twice } { \iow_char:N \\placeaside~used~twice;~ignored. }
\tl_new:N \l__vitae_aside_width_tl
\tl_new:N \l__vitae_aside_sep_tl
\bool_new:N \l__vitae_aside_left_bool
\bool_new:N \l__vitae_aside_after_bool
\keys_define:nn { vitae / aside }
  {
    width .tl_set:N   = \l__vitae_aside_width_tl ,
    width .initial:n  = 0.3 \textwidth ,
    sep   .tl_set:N   = \l__vitae_aside_sep_tl ,
    sep   .initial:n  = 1cm ,
    side  .choices:nn = { left , right }
      { \bool_set:Nn \l__vitae_aside_left_bool { \int_compare_p:nNn { \l_keys_choice_int } = { 1 } } } ,
    side  .initial:n  = left ,
    order .choices:nn = { after , before }
      { \bool_set:Nn \l__vitae_aside_after_bool { \int_compare_p:nNn { \l_keys_choice_int } = { 1 } } } ,
    order .initial:n  = after ,
  }
\bool_new:N \g__vitae_aside_bool
\bool_new:N \g__vitae_aside_placed_bool
\dim_new:N \g__vitae_aside_width_dim
\dim_new:N \g__vitae_aside_shift_dim
\box_new:N \g__vitae_aside_box
\box_new:N \l__vitae_aside_slice_box
\mark_new_class:n { vitae-aside }
% \vitaeasidecolumn{<keys>}: in a theme's preamble code.
\NewDocumentCommand \vitaeasidecolumn { m }
  {
    \keys_set:nn { vitae / aside } {#1}
    \bool_gset_true:N \g__vitae_aside_bool
    \vitaeplaceregions { aside }
  }
\@onlypreamble \vitaeasidecolumn
% Split the text block (after geometry has set it). The shift is where the
% column's left edge lies, from main's left edge.
\hook_gput_code:nnn { begindocument / end } { vitae }
  {
    \bool_if:NT \g__vitae_aside_bool
      {
        \dim_gset:Nn \g__vitae_aside_width_dim { \l__vitae_aside_width_tl }
        \dim_set:Nn \l_tmpa_dim { \g__vitae_aside_width_dim + \l__vitae_aside_sep_tl }
        \dim_gsub:Nn \textwidth { \l_tmpa_dim }
        \dim_set_eq:NN \hsize \textwidth
        \dim_set_eq:NN \linewidth \textwidth
        \dim_set_eq:NN \columnwidth \textwidth
        \bool_if:NTF \l__vitae_aside_left_bool
          {
            \dim_gadd:Nn \oddsidemargin { \l_tmpa_dim }
            \dim_gadd:Nn \evensidemargin { \l_tmpa_dim }
            \dim_gset:Nn \g__vitae_aside_shift_dim { - \l_tmpa_dim }
          }
          { \dim_gset:Nn \g__vitae_aside_shift_dim { \textwidth + \l__vitae_aside_sep_tl } }
      }
  }
% Take the next part of the column, at most #2 high, into #1 (top-aligned).
\cs_new_protected:Npn \__vitae_aside_split:Nn #1#2
  {
    \group_begin:
      \int_set:Nn \vbadness { 10000 }
      \skip_set_eq:NN \splittopskip \topskip
      \vbox_set_split_to_ht:NNn \l__vitae_aside_slice_box \g__vitae_aside_box {#2}
      \vbox_gset_top:Nn #1 { \vbox_unpack_drop:N \l__vitae_aside_slice_box }
    \group_end:
  }
% Hang #1 beside main from the current point, taking no space.
\cs_new_protected:Npn \__vitae_aside_hang:N #1
  {
    \vbox_to_zero:n
      {
        \hbox_to_zero:n
          { \skip_horizontal:n { \g__vitae_aside_shift_dim } \box_use_drop:N #1 \tex_hss:D }
        \tex_vss:D
      }
  }
\box_new:N \g__vitae_aside_part_box
% \placeaside: start the column here (in a theme's template, once).
\NewDocumentCommand \placeaside { }
  {
    \bool_if:NTF \g__vitae_aside_bool
      {
        \bool_if:NTF \g__vitae_aside_placed_bool
          { \msg_warning:nn { vitae } { aside-twice } }
          {
            \bool_gset_true:N \g__vitae_aside_placed_bool
            \par
            \vbox_gset:Nn \g__vitae_aside_box
              {
                \dim_set_eq:NN \hsize \g__vitae_aside_width_dim
                \dim_set_eq:NN \linewidth \hsize
                \dim_set_eq:NN \columnwidth \hsize
                \dim_set_eq:NN \textwidth \hsize
                \tag_if_active:T
                  {
                    \bool_if:NTF \l__vitae_aside_after_bool
                      { \tag_struct_begin:n { tag = Aside , stash , label = vitae-aside } }
                      { \tag_struct_begin:n { tag = Aside } }
                  }
                \__vitae_template_use:n { aside }
                \par
                \tag_if_active:T { \tag_struct_end: }
              }
            \box_if_empty:NF \g__vitae_aside_box
              {
                % On an empty page \pagegoal is \maxdimen: the first line
                % comes \topskip below the top of the text block.
                \__vitae_aside_split:Nn \g__vitae_aside_part_box
                  {
                    \dim_compare:nNnTF \pagegoal = \c_max_dim
                      { \textheight - \topskip }
                      { \pagegoal - \pagetotal - \pagedepth }
                  }
                \mark_insert:nn { vitae-aside } { start }
                \nointerlineskip
                \__vitae_aside_hang:N \g__vitae_aside_part_box
              }
          }
      }
      { \msg_error:nn { vitae } { no-aside-column } }
  }
% \vitaefullwidth{<content>}: a block across main and the column, from the
% current point (a band above both, say); it does not break across pages.
% Without a column, the content is printed as it is.
\box_new:N \l__vitae_aside_full_box
\NewDocumentCommand \vitaefullwidth { +m }
  {
    \par
    \bool_if:NTF \g__vitae_aside_bool
      {
        \vbox_set:Nn \l__vitae_aside_full_box
          {
            \dim_set:Nn \hsize
              { \textwidth + \g__vitae_aside_width_dim + \l__vitae_aside_sep_tl }
            \dim_set_eq:NN \linewidth \hsize
            \dim_set_eq:NN \columnwidth \hsize
            #1 \par
          }
        \bool_if:NTF \l__vitae_aside_left_bool
          {
            \box_move_left:nn { \g__vitae_aside_width_dim + \l__vitae_aside_sep_tl }
              { \box_use_drop:N \l__vitae_aside_full_box }
          }
          { \box_use_drop:N \l__vitae_aside_full_box }
      }
      {#1}
  }
% Each later page: the next part at the top of the page body. The page
% where the column starts (its mark is first on the page) is skipped.
\hook_gput_code:nnn { build / page / before } { vitae }
  {
    \box_if_empty:NF \g__vitae_aside_box
      {
        \mark_if_eq:nnnnT { page } { vitae-aside } { top } { first }
          {
            \__vitae_aside_split:Nn \g__vitae_aside_part_box { \box_ht:N \@outputbox }
            \vbox_set_to_ht:Nnn \@outputbox { \box_ht:N \@outputbox }
              {
                \__vitae_aside_hang:N \g__vitae_aside_part_box
                \vbox_unpack_drop:N \@outputbox
              }
          }
      }
  }
% At the end: pages for a column that outlasts main; the Aside element
% after main in the structure tree.
\hook_gput_code:nnn { enddocument } { vitae }
  {
    \box_if_empty:NF \g__vitae_aside_box
      {
        \clearpage
        \bool_until_do:nn { \box_if_empty_p:N \g__vitae_aside_box }
          { \hbox:n { } \clearpage }
      }
    \bool_lazy_all:nT
      {
        { \tag_if_active_p: }
        { \g__vitae_aside_placed_bool }
        { \l__vitae_aside_after_bool }
      }
      { \tag_struct_use:n { vitae-aside } }
  }

% --- Themes ---------------------------------------------------------------
% \usetheme{<name>} loads vitaetheme<name>.sty once, then re-applies user
% \vitaesetup keys over the theme defaults. Without \usetheme, "classic"
% is loaded at the end of the preamble.
\tl_new:N \g__vitae_theme_tl
\NewDocumentCommand \usetheme { m }
  {
    \tl_if_empty:NTF \g__vitae_theme_tl
      {
        \file_if_exist:nTF { vitaetheme#1.sty }
          {
            \tl_gset:Nn \g__vitae_theme_tl {#1}
            \RequirePackage { vitaetheme#1 }
            \keys_set:nV { vitae / setup } \g__vitae_setup_tl
          }
          { \msg_error:nnn { vitae } { unknown-theme } {#1} }
      }
      {
        \tl_if_eq:NnF \g__vitae_theme_tl {#1}
          { \msg_error:nnVn { vitae } { second-theme } \g__vitae_theme_tl {#1} }
      }
  }
\@onlypreamble \usetheme
\hook_gput_code:nnn { begindocument / before } { vitae }
  {
    \tl_if_empty:NT \g__vitae_theme_tl { \usetheme { classic } }
    % Tagging (\DocumentMetadata) is validated on LuaTeX only.
    \tag_if_active:T
      { \sys_if_engine_luatex:F { \msg_warning:nn { vitae } { tagging-engine } } }
    % The main language (babel/polyglossia) should have a locale.
    \bool_lazy_and:nnT
      { \tl_if_blank_p:V \l__vitae_locale_tl }
      { \cs_if_exist_p:N \languagename }
      {
        \tl_if_exist:cF { g__vitae_locale_alias_ \languagename _tl }
          { \msg_warning:nnV { vitae } { unknown-locale } \languagename }
      }
    % Document title (shown by viewers; required by PDF/UA): the name,
    % followed by the job title if set.
    \hypersetup
      {
        pdfauthor = { \thefirstname \c_space_tl \thelastname } ,
        pdftitle  =
          {
            \thefirstname \c_space_tl \thelastname
            \ifvitaeset { jobtitle } { \c_space_tl \textendash \c_space_tl \thejobtitle } { }
          } ,
      }
  }
