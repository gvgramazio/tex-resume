% --- Identification -------------------------------------------------------
\ProvidesExplPackage{vitaethememodern}{2026-11-22}{0.4.0}{vitae modern theme}

% --- Fonts ----------------------------------------------------------------
% Fira Sans as the document font; FiraSans.sty handles every engine.
\RequirePackage [ sfdefault ] { FiraSans }

% --- Page and lists -------------------------------------------------------
\RequirePackage { enumitem }
\setlist { nosep , leftmargin = 1em , topsep = 2pt }
\geometry { margin = 1.8cm }
\definecolor { vitaemodernblue } { HTML } { 1F5F8B }
% Defaults via \keys_set:nn, not \vitaesetup, so user settings still win.
\keys_set:nn { vitae / setup } { accent = vitaemodernblue }

% Width of the left column holding dates and item labels.
\dim_new:N \l__vitae_modern_col_dim
\dim_set:Nn \l__vitae_modern_col_dim { 2.8cm }

% Hanging layout: <left> in the margin column, <body> beside it.
% 1. The label is set in a top-aligned box, then given zero depth, so a
%    label that wraps cannot push the body's second line down.
% 2. The body (a list holding the label) is set in a box only to measure
%    it, then unpacked: its lines still break across pages. \prevdepth
%    is carried in and out so baselines continue as if no box existed.
% 3. If the label reaches below the body, a kern adds the missing space
%    and \prevdepth takes the label's last-line depth, so the next line
%    follows the label's last baseline exactly as it would a body line.
\box_new:N \l__vitae_modern_label_box
\box_new:N \l__vitae_modern_body_box
\dim_new:N \l__vitae_modern_prevdepth_dim
\dim_new:N \l__vitae_modern_reach_dim
\dim_new:N \l__vitae_modern_last_dim
\cs_new_protected:Npn \__vitae_modern_hang:nn #1#2
  {
    \par
    % Label: bottom-aligned first (to read its last-line depth), then
    % top-aligned. \leavevmode: a leading \color must not shift baselines.
    \vbox_set:Nn \l__vitae_modern_label_box
      {
        \dim_set:Nn \hsize { \l__vitae_modern_col_dim - 1em }
        \raggedright \leavevmode #1 \par
      }
    \dim_set:Nn \l__vitae_modern_last_dim { \box_dp:N \l__vitae_modern_label_box }
    \vbox_set_top:Nn \l__vitae_modern_label_box
      { \vbox_unpack_drop:N \l__vitae_modern_label_box }
    % Reach: the label's bottom, measured from the body box top. The first
    % baseline lies below the interline glue TeX will add at that top.
    \dim_set_eq:NN \l__vitae_modern_prevdepth_dim \prevdepth
    \dim_set:Nn \l__vitae_modern_reach_dim
      {
        \dim_compare:nNnTF \prevdepth > { -1000pt }
          {
            \dim_max:nn { \baselineskip - \prevdepth }
              { \box_ht:N \l__vitae_modern_label_box + \lineskip }
          }
          { \box_ht:N \l__vitae_modern_label_box }
        + \box_dp:N \l__vitae_modern_label_box
      }
    \box_set_dp:Nn \l__vitae_modern_label_box { 0pt }
    \vbox_set:Nn \l__vitae_modern_body_box
      {
        \dim_set_eq:NN \hsize \linewidth
        \dim_set_eq:NN \prevdepth \l__vitae_modern_prevdepth_dim
        \begin { list } { }
          {
            \dim_set_eq:NN \leftmargin \l__vitae_modern_col_dim
            \dim_set:Nn \labelwidth { \l__vitae_modern_col_dim - 1em }
            \dim_set:Nn \labelsep { 1em }
            \skip_zero:N \topsep \skip_zero:N \partopsep
            \skip_zero:N \itemsep \skip_zero:N \parsep
          }
          \item [ { \box_use:N \l__vitae_modern_label_box } ] #2
        \end { list }
      }
    \vbox_unpack:N \l__vitae_modern_body_box
    % Reach below the body's last baseline; compare with the body's depth.
    \dim_sub:Nn \l__vitae_modern_reach_dim { \box_ht:N \l__vitae_modern_body_box }
    \dim_compare:nNnTF \l__vitae_modern_reach_dim > { \box_dp:N \l__vitae_modern_body_box }
      {
        \tex_kern:D \dim_eval:n
          { \l__vitae_modern_reach_dim - \box_dp:N \l__vitae_modern_body_box }
        \dim_set:Nn \prevdepth
          { \dim_min:nn \l__vitae_modern_reach_dim \l__vitae_modern_last_dim }
      }
      { \dim_set:Nn \prevdepth { \box_dp:N \l__vitae_modern_body_box } }
  }

% --- Templates ------------------------------------------------------------
% Header: large coloured name and contacts on the left, photo on the right.
\settemplate { header }
  {
    \noindent
    \begin { minipage } [ b ]
      {
        \dim_eval:n
          { \ifvitaeset { photo } { \linewidth - \vitaephotowidth - 1em } { \linewidth } }
      }
      \taggedheading { 1 }
        { { \Huge \bfseries \color { vitaeaccent } \thefirstname \c_space_tl \thelastname \par } }
      \ifvitaeset { jobtitle } { \smallskip { \Large \thejobtitle \par } } { }
      \medskip \small \raggedright \printcontacts
    \end { minipage }
    \hfill \printphoto \par \bigskip
  }
\settemplate { contact }
  { \mbox { \textcolor { vitaeaccent } { \field { icon } } ~ \field { text } } }
\settemplate { contactsep } { \hspace { 1.2em plus .5em } }

% Section: bold uppercase accent title followed by a rule to the margin.
\settemplate { section }
  {
    \par \addvspace { \bigskipamount }
    \taggedheading { 2 }
      {
        \noindent
        { \large \bfseries \color { vitaeaccent } \MakeUppercase { \field { title } } }
        \hspace { .5em } { \color { vitaeaccent } \leaders \hrule height .6pt \hfill }
        \par
      }
    \nopagebreak \medskip
  }

% Margin label of entries: dates, with the duration below when enabled.
\cs_new_protected:Npn \__vitae_modern_dates:
  {
    \small \color { vitaeaccent } \field { dates }
    \iffield { duration } { \par \field { duration } } { }
  }

% Entry: dates in the margin column; title, org and location beside them.
% Each line is emitted only if one of its fields is set (no blank lines).
\settemplate { entry }
  {
    \__vitae_modern_hang:nn
      { \__vitae_modern_dates: }
      {
        \iffield { title } { \textbf { \field { title } } \par } { }
        \iffield { org }
          { \textit { \field { org } } \iffield { location } { ,~ \field { location } } { } \par }
          { \iffield { location } { \field { location } \par } { } }
        \iffield { body } { \smallskip \field { body } } { }
      }
    \medskip
  }

% Compact entry: dates in the margin column; title, organisation and
% location on one line beside them; any body follows below.
\settemplate { entry/compact }
  {
    \__vitae_modern_hang:nn
      { \__vitae_modern_dates: }
      {
        \joinfields { , ~ } { title = \textbf , org = \textit , location } \par
        \iffield { body } { \field { body } } { }
      }
    \smallskip
  }

% Inline entry: dates in the margin column; beside them a run-in
% paragraph, "Title, Org, Location. Body", with no stray punctuation.
\settemplate { entry/inline }
  {
    \__vitae_modern_hang:nn
      { \__vitae_modern_dates: }
      {
        \ifanyfield { title , org , location }
          {
            \joinfields { , ~ } { title = \textbf , org = \textit , location }
            \addpunct { . } \iffield { body } { ~ } { }
          }
          { }
        \field { body }
      }
    \smallskip
  }

% Item: bold label in the margin column, text beside it. Two top-aligned
% boxes (items are short): a wrapped label cannot push the text down.
\settemplate { item }
  {
    \par \noindent
    \parbox [ t ] { \dim_eval:n { \l__vitae_modern_col_dim - 1em } }
      { \raggedright \leavevmode \small \bfseries \color { vitaeaccent } \field { label } }
    \hspace { 1em }
    \parbox [ t ] { \dim_eval:n { \linewidth - \l__vitae_modern_col_dim } } { \field { body } }
    \par \smallskip
  }
