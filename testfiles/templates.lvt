% Templates: overriding, unknown names, sections, masthead warning, aliases.
\documentclass{vitae}
\input{regression-test}
\START

\TEST{unknown template is an error}{
  \settemplate{nosuchtemplate}{}
}

\TEST{\section uses the section template (starred too)}{
  \settemplate{section}{\TYPE{section=[\field{title}]}}
  \section{Lorem}
  \section*{Ipsum}
}

\TEST{\makemasthead without a name warns}{
  \settemplate{masthead}{\TYPE{masthead}}
  \makemasthead
}

\TEST{\makemasthead with only a name is silent}{
  \settemplate{masthead}{\TYPE{masthead: \thefirstname/\thelastname}}
  \name{Jane}{}
  \makemasthead
}

\TEST{template overrides are scoped like any definition}{
  \settemplate{item}{\TYPE{outer}}
  {\settemplate{item}{\TYPE{inner}}\cvitem{}{}}
  \cvitem{}{}
}

\TEST{deprecated names still work and warn}{
  \settemplate{header}{\TYPE{masthead via the old template name}}
  \name{Jane}{Doe}
  \makeheader
}

\END
