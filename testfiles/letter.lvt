% vitaeletter: recipient, date and salutation reach the opening template,
% the closing template signs, and resume data files load unchanged.
\documentclass{vitaeletter}
\input{regression-test}
\name{Jane}{Doe}
\START

\TEST{the date defaults to the day of compilation, as an ISO date}{
  \settemplate{header}{}
  \settemplate{opening}{\TYPE{\field{date}}}
  \vitaesetup{dateformat=iso}
  \opening{}
}

\TEST{\opening prints the header, then the opening template}{
  \settemplate{header}{\TYPE{header: \thefirstname/\thelastname}}
  \settemplate{opening}{\TYPE{[\field{name}][\field{address}][\field{date}][\field{text}]}}
  \recipient{Hiring Manager}{Lorem Ltd.}
  \letterdate{2026-11}
  \opening{Dear Hiring Manager,}
}

\TEST{the date follows the date style and locale}{
  \settemplate{header}{}
  \settemplate{opening}{\TYPE{[\field{date}]}}
  \letterdate{2026-11}
  \vitaesetup{datelocale=italian}
  \opening{}
  \vitaesetup{dateformat=numeric}
  \opening{}
  \letterdate{not a date}
  \opening{}
}

\TEST{\letterdate{} leaves the date out}{
  \settemplate{header}{}
  \settemplate{opening}{\iffield{date}{\TYPE{date set}}{\TYPE{no date}}}
  \letterdate{}
  \opening{}
}

\TEST{blank recipient and salutation are blank fields}{
  \settemplate{header}{}
  \settemplate{opening}{\TYPE{[\iffield{name}{name}{}][\iffield{address}{address}{}][\iffield{text}{text}{}]}}
  \recipient{}{}
  \opening{}
}

\TEST{\closing passes its text to the closing template}{
  \settemplate{closing}{\TYPE{[\field{text}] \thefirstname}}
  \closing{Kind regards,}
}

\TEST{letter fields do not leak}{
  \settemplate{header}{}
  \settemplate{opening}{}
  \recipient{Hiring Manager}{Lorem Ltd.}
  \opening{Dear Hiring Manager,}
  \TYPE{[\field{name}][\field{address}][\field{date}][\field{text}]}
}

\TEST{resume data (\addentry, \additem) loads without output}{
  \addentry{work}{title=Lorem}{Ipsum}
  \additem{skills}{Lorem}{Ipsum}
  \TYPE{stored}
}

\END
